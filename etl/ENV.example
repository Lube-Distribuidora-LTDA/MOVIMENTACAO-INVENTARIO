# Copie este arquivo, renomeie a copia para "ENV" (sem extensao, exatamente
# esse nome) e coloque na MESMA pasta dos scripts (etl/) -- ou, na rede, em
# P:\INTEGRACAO BI\INVENTARIO\1 - CONFIGURACAO.
# NUNCA compartilhe o arquivo "ENV" depois de preenchido (ele guarda senha).

# --- Oracle / WinThor (somente leitura) ---------------------------------
ORACLE_HOST=ip_do_servidor_oracle
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=nome_do_service
ORACLE_USER=usuario_de_leitura
ORACLE_PASSWORD=coloque_a_senha_aqui

# --- Supabase (projeto DATA WAREHOUSE) ------------------------------------
# Session pooler (porta 5432). Campos separados, e a senha ENTRE ASPAS DUPLAS:
# se ela tiver um "#", sem aspas tudo depois dele vira comentario e a senha e
# cortada pela metade, sem aviso nenhum.
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.id_do_projeto
SUPABASE_DB_PASSWORD="cole_a_senha_aqui"

# --- Recortes das consultas (opcional) -----------------------------------
# Primeira data carregada. Padrao 2025-01-01: dois anos para comparar com o anterior.
# INVENTARIO_DATA_INICIAL=2025-01-01
# Filiais de distribuicao. Padrao 1,7,10,11,12 (fora: 3 SERMAR, 4 L LOG, 6 IMPERIO).
# INVENTARIO_FILIAIS=1,7,10,11,12

# --- Opcional -------------------------------------------------------------
LOG_LEVEL=INFO
